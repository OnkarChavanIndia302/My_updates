package home_work;

public class charr {

    public void showchar(String str) {

        System.out.println("Length: " + str.length());
        System.out.println("Character at index 1: " + str.charAt(1));

        System.out.println();

    

        System.out.println("using while loop forward string ");

        int i = 0;
        while (i < str.length()) {

            System.out.println("Char at " + i + ": " + str.charAt(i));
            i++;
        }

        System.out.println();
        
        System.out.println("using for loop forward string ");
        
        for (int j = 0; j < str.length(); j++) {

            System.out.println("Char at " + j + ": " + str.charAt(j));
        }

        System.out.println();

        
        System.out.println("using for loop reverese string ");

        for (int j = str.length() - 1; j >= 0; j--) {

            System.out.println("Char at " + j + ": " + str.charAt(j));
            
        }
        
        System.out.println("using while loop reverese string ");
        int s = str.length() -1 ;
        while (s>=0) {
        	System.out.println(str.charAt(s));
        	s-- ;
        	
        }
        
    }
    

    public static void main(String[] args) {

        charr obj = new charr();

        obj.showchar("onkar");
    }
}

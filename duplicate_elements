package day_01;

public class day4 {
public void duplicate_Array(int arr[]) {
	
	for(int i = 0 ; i <arr.length ; i++) {
		for(int j = i+1 ; j<arr.length ; j++ ) {
			if(arr[i] == arr[j]) {
				System.out.print(arr[i]+" " );
			}
		}
	}
			
}
public static void main(String[] args) {
	day4 obj = new day4 () ;
	int arr [] = {10,20,305,05,10,20}; 
	
	obj.duplicate_Array(arr);
}
}

package dropdowns;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;
import org.openqa.selenium.support.ui.Select;

public class select_dropdowm {
	WebDriver driver;
	Actions act ;

	void openbr() {
		driver = new ChromeDriver();
		driver.get("https://www.globalsqa.com/demo-site/select-dropdown-menu/");
	}
	public void select_dropdown() {
		
		WebElement dropcountry = driver.findElement(By.xpath("//div[@class='single_tab_div resp-tab-content resp-tab-content-active']//p//select"));
		
		//select method selects the country 
		Select select_cntry = new Select(dropcountry);

		//select country from dropdown
		//select by visible text 
		select_cntry.selectByVisibleText("India");
		
		//select by value 
		select_cntry.selectByValue("JPN");
		
		
		//select by the index
		select_cntry.selectByIndex(2);
		
		// getting count of the countris from the dropdown 
		List<WebElement> drp_options = select_cntry.getOptions();
		System.out.println(drp_options.size());
		
		//print all the countries 
		for(int i = 0 ;i<drp_options.size();i++) {
			System.out.println(drp_options.get(i).getText());
		}


	}
	public static void main(String[] args) {
		select_dropdowm obj = new select_dropdowm();
		obj.openbr();
		obj.select_dropdown();
		

	}
}


